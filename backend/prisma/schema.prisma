generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model Document {
  rowId     String   @id @db.Uuid @map("row_id")
  model     String
  docId     String   @map("doc_id")
  data      Json
  createdAt DateTime
  updatedAt DateTime

  @@unique([model, docId])
  @@map("documents")
}

model DashboardActivity {
  id        String   @id @default(uuid())
  actor     String
  action    String
  severity  String   @default("info")
  time      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_activities")
}

model TenantCompany {
  id         String   @id @default(uuid())
  companyName String?
  companyCode String?
  industry   String?
  status     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("tenant_companies")
}

model GlobalUser {
  id         String   @id @default(uuid())
  name       String?
  email      String?
  role       String?
  companyName String?
  status     String?
  lastLogin  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("global_users")
}

model Subscription {
  id          String   @id @default(uuid())
  companyName String?
  planName    String?
  status      String?
  startDate   DateTime?
  endDate     DateTime?
  autoRenewal Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subscriptions")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String?
  companyName   String?
  amount        Float    @default(0)
  status        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("invoices")
}

model PaymentTransaction {
  id         String   @id @default(uuid())
  amount     Float    @default(0)
  status     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("payment_transactions")
}

model SupportTicket {
  id         String   @id @default(uuid())
  ticketId   String?
  subject    String?
  companyName String?
  priority   String?
  status     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("support_tickets")
}

model AuditLog {
  id          String   @id @default(uuid())
  actor       String
  actorRole   String?
  module      String
  action      String
  description String?
  severity    String   @default("info")
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model SystemHealthLog {
  id             String   @id @default(uuid())
  status         String
  apiStatus      String
  databaseStatus String
  storageStatus  String
  uptime         String
  message        String?
  createdAt      DateTime @default(now())

  @@map("system_health_logs")
}
